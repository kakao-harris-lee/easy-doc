# ktlint 규칙의 정본. 저장소 루트가 아니라 backend-kotlin/ 에 두어 Python·React 쪽
# 에디터 설정과 섞이지 않게 한다.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

# 한국어 KDoc·주석이 길어 import 정렬만 강제하고 wildcard 는 막는다.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

# 테스트 함수 이름을 한국어 백틱 식별자로 쓴다 (Python 테스트 이름과 1:1로 대응시키기 위해).
ktlint_function_naming_ignore_when_annotated_with = Test,ParameterizedTest

# 파라미터가 하나뿐인 클래스 선언은 한 줄로 둔다. 기본값(ktlint_official)은 상위 타입이
# 있으면 1개부터 여러 줄로 펴는데, `class NotFoundException(message: String) : EasyDocException(message)`
# 같은 도메인 예외 15개가 전부 3줄로 늘어나 원본(app/exceptions.py)과 나란히 읽기 어려워진다.
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4
