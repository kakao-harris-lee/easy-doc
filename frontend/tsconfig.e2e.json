{
  /* 브라우저 E2E 하네스 전용 프로젝트.
     `tsconfig.app.json`(앱 소스)과 가르는 이유는 두 가지다 —
     ① e2e 는 node 전역(process·fs·URL)을 쓰고 앱 소스는 쓰면 안 된다.
     ② `vite build` 가 e2e 를 번들에 끌어들이지 않아야 한다(`include` 가 `src` 뿐이다).
     대신 `tsc -b` 는 이 프로젝트도 빌드하므로 타입 게이트에서 빠지지 않는다. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    /* DOM 이 필요하다 — `page.evaluate` 안의 코드가 window·fetch 를 쓴다. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode — 앱 프로젝트와 같은 해석 규칙을 쓴다. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* 타입 안전 — 앱 프로젝트와 같은 기준선 */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
