# VITE_ 값은 번들에 포함되므로 비밀키를 넣지 않는다. 배포 기본값은 /api다.
VITE_API_BASE_URL=http://localhost:8000
# Vite 로컬 개발용. 서버의 extra-easy 토글과 함께 켠다.
# Docker 배포에서는 루트 .env의 EASYDOC_READING_LEVEL_EXTRA_EASY_ENABLED를 함께 사용한다.
VITE_EASYDOC_EXTRA_EASY_ENABLED=false
# 중등 수준은 기존 호환을 위해 기본적으로 켜져 있다. 품질 평가 전 유료 배포는 false로 빌드한다.
# Docker 배포에서는 루트 .env의 EASYDOC_READING_LEVEL_MIDDLE_SCHOOL_ENABLED를 함께 사용한다.
VITE_EASYDOC_MIDDLE_SCHOOL_ENABLED=true
