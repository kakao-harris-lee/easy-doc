# 실제 값은 .env에만 넣고 커밋 금지
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 변환 워커가 쓸 LLM 벤더 (anthropic | openai). 기본값 anthropic은 '벤더 미확정' 상태이며,
# 벤치마크로 확정되면 master-plan 3.1 기록 표와 함께 갱신한다.
# 벤치마크·골든셋 평가는 이 값이 아니라 각자의 --providers·GOLDEN_PROVIDER를 쓴다.
LLM_PROVIDER=anthropic

# 위 벤더의 모델명 덮어쓰기. 비워 두면 provider 구현체의 기본 모델을 쓴다
# (openai=gpt-4.1 — 근거: docs/quality/2026-08-07-model-comparison.md).
# 모델 교체·롤백을 코드 수정 없이 하기 위한 값이며, 다른 벤더에는 적용되지 않는다.
# LLM_MODEL=

# Anthropic 전용 사고 깊이: low | medium | high | xhigh | max. 비워 두면 API 기본값(high).
# 낮출수록 사고 토큰·지연·원가가 줄고 품질이 떨어질 수 있다 — 바꾸기 전에 벤치마크로 확인할 것.
# LLM_EFFORT=

# 인프라 (기본값은 docker-compose.yml 기준 — 로컬 개발이면 그대로 두어도 된다)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/easydoc
REDIS_URL=redis://localhost:6379/0

# 브라우저에서 API를 부를 수 있는 오리진 (JSON 배열). 기본값은 개발용 Vite 서버 하나다 —
# 파일럿 배포는 nginx가 프론트·API를 같은 호스트로 서빙해 cross-origin이 아니다.
CORS_ORIGINS=["http://localhost:5173"]

# 인증 토큰 서명 키 — 생성: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# 문서 본문 암호화 키 — 생성:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Kotlin 런타임(backend-kotlin) 저장 암호화 ─────────────────────────────────
#
# 위 FERNET_KEY 와 **다른 축이다.** Python 은 Fernet, Kotlin 은 표준 AEAD(AES-256-GCM)이고
# 2026-08-12 재개발 전환으로 둘 사이의 암호문 호환 요구가 사라졌다(master-plan 6.2).
#
# 키 생성:
#   openssl rand -base64 32
#
# 검사값(KCV)은 **비밀이 아니다** — 키가 맞는지 배포 파이프라인이 대조하는 지문이고,
# 값을 모르면 KCV 없이 한 번 띄워라. 기동이 실패하면서 계산된 값을 알려 준다.
# 두 값을 같은 비밀 저장소에서 함께 받아 오지 않는다 — 그러면 대조가 아무것도 확인하지 않는다.
EASYDOC_ENCRYPTION_WRITE_KEY_VERSION=1
EASYDOC_ENCRYPTION_KEY_V1=
EASYDOC_ENCRYPTION_KCV_V1=
