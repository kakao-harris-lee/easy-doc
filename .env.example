# 실제 값은 .env에만 넣고 커밋 금지

# --- Kotlin 백엔드(backend-kotlin) 공통 ---

# PostgreSQL 접속 (호스트에서 백엔드를 실행할 때의 기본값)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/easydoc
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# 인증 토큰 서명 키 — 생성: openssl rand -hex 32 (32바이트 이상 필수, 짧으면 인증 요청이 503으로 거부된다)
EASYDOC_AUTH_JWT_SECRET=

# --- 소셜 로그인 — Google (backlog §1.4 P0-1, 명시적 계정 연결은 2.10.0) ---
#
# Google Cloud Console(OAuth 2.0 클라이언트 ID)에서 발급한다. 승인된 리디렉션 URI에
# 아래 EASYDOC_OAUTH_GOOGLE_REDIRECT_URIS 와 정확히 같은 값을 **둘 다** 등록해야 한다 —
# 로그인/가입(oauthStart·oauthCallback)과 이미 로그인한 계정에 구글을 잇는 명시적 연결
# (oauthLinkStart·oauthLinkCallback)이 서로 다른 콜백 경로를 쓴다:
#   - 로그인:  http://localhost:5173/auth/google/callback
#   - 계정 연결: http://localhost:5173/auth/google/link/callback
# (운영 배포는 두 경로 모두 실제 도메인으로 바꿔 등록한다.)
#
# 비워 두면 앱은 뜨지만 google 소셜 로그인만 422("구글 로그인이 설정되지 않았습니다")로
# 응답한다 — 기동을 막지 않는다(EASYDOC_LLM_* 키 미설정과 같은 방침).
EASYDOC_OAUTH_GOOGLE_CLIENT_ID=
EASYDOC_OAUTH_GOOGLE_CLIENT_SECRET=
# 콤마로 구분한 허용 redirect_uri 목록. 비우면 로컬 기본값(위 코멘트의 두 경로)만 허용된다 —
# 하나만 등록하면 다른 쪽 오퍼레이션이 422 "허용되지 않은 redirect_uri 입니다"로 거절된다.
EASYDOC_OAUTH_GOOGLE_REDIRECT_URIS=

# --- 문서 본문 저장 암호화 (AES-256-GCM) ---
#
# 키 생성: openssl rand -base64 32
#
# KCV(키 검사값)는 비밀이 아니다 — 키가 맞는지 대조하는 지문이다. 모르면 비워 두고
# 한 번 띄운다. 기동이 실패하면서 계산된 값을 알려 준다. 두 값을 같은 비밀 저장소에서
# 함께 받아오지 않는다 — 그러면 대조가 아무것도 확인하지 않는다.
EASYDOC_ENCRYPTION_WRITE_KEY_VERSION=1
EASYDOC_ENCRYPTION_KEY_V1=
EASYDOC_ENCRYPTION_KCV_V1=

# --- LLM provider ---
#
# 기본은 anthropic. CI·Playwright E2E 는 compose.e2e.yml 이 api·worker 에만 fake 를 넣는다.
# fake 는 Spring 프로필 local 또는 test 에서만 조립된다. compose.yml 의 api·worker 가 local 을 켠다.
# 운영(worker 만)에서 fake 를 넣으면 기동이 실패한다.
# 키가 없는 openai/anthropic 은 앱은 뜨지만, 변환은 ConfigurationException 으로 즉시 영구 실패한다
# (재시도하지 않는다).
EASYDOC_LLM_PROVIDER=anthropic
EASYDOC_LLM_MODEL=
# Anthropic 전용 사고 깊이: low | medium | high | xhigh | max
EASYDOC_LLM_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 선택한 모델의 현재 공개 단가를 배포 시점에 넣는다. 코드에 가격을 고정하지 않는다.
# 둘은 함께 채우거나 함께 비운다(하나만 채우면 기동 시 ConfigurationException).
# 비워 두면 비용이 0달러가 아니라 null 로 관측된다.
# 기준(2026-09-04 재확인, platform.claude.com/docs/en/about-claude/pricing):
#   claude-sonnet-5  입력 2 / 출력 10 USD per MTok
#   (출시 시 예고됐던 2026-09-01 3/15 인상은 취소됐고 2/10 이 표준가로 확정됐다.)
#   EASYDOC_LLM_MODEL 을 바꾸면 이 두 값도 함께 바꾼다.
EASYDOC_LLM_INPUT_USD_PER_MILLION_TOKENS=
EASYDOC_LLM_OUTPUT_USD_PER_MILLION_TOKENS=

# --- 변환 완료 메일 알림(P0-3) ---
#
# provider 는 fake·smtp 둘이다. smtp 는 임시 relay(2026-09-04 사용자 결정 — Daum 등 소비자
# 메일 계정, SES 전환 전까지)이고, SES 가 의도한 운영 provider 다(docs/kotlin-redevelopment-backlog.md
# §1.4). fake 는 메모리에만 기록하고 실제 네트워크 호출을 하지 않는다. 다른 값을 주면
# api·worker 기동이 즉시 실패한다.
EASYDOC_MAIL_PROVIDER=fake
EASYDOC_MAIL_FROM_ADDRESS=no-reply@easydoc.kr
EASYDOC_MAIL_TIMEOUT_MS=5000

# provider=smtp 일 때만 읽힌다. host·username·password 는 비밀값이라 여기 값을 채우지
# 않는다 — 실제 값은 .env 에만. Daum·Naver 등 소비자 메일은 EASYDOC_MAIL_FROM_ADDRESS 가
# 이 계정(EASYDOC_MAIL_SMTP_USERNAME)과 같은 주소가 아니면 발송을 거절한다.
# ssl=true 는 접속 시점 암시적 TLS(SMTPS, 보통 465) — STARTTLS 가 아니다.
EASYDOC_MAIL_SMTP_HOST=
EASYDOC_MAIL_SMTP_PORT=465
EASYDOC_MAIL_SMTP_SSL=true
EASYDOC_MAIL_SMTP_USERNAME=
EASYDOC_MAIL_SMTP_PASSWORD=

# 알림 메일 링크 등 사용자에게 보이는 절대 URL의 기준(프런트엔드 도메인). 로컬 기본값은
# frontend dev 서버 포트(frontend/vite.config.ts).
EASYDOC_APP_PUBLIC_BASE_URL=http://localhost:5173
