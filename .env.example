# 실제 값은 .env에만 넣고 커밋 금지

# --- Kotlin 백엔드(backend-kotlin) 공통 ---

# PostgreSQL 접속 (호스트에서 백엔드를 실행할 때의 기본값)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/easydoc
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# 인증 토큰 서명 키 — 생성: openssl rand -hex 32 (32바이트 이상 필수, 짧으면 인증 요청이 503으로 거부된다)
EASYDOC_AUTH_JWT_SECRET=

# --- 문서 본문 저장 암호화 (AES-256-GCM) ---
#
# 키 생성: openssl rand -base64 32
#
# KCV(키 검사값)는 비밀이 아니다 — 키가 맞는지 대조하는 지문이다. 모르면 비워 두고
# 한 번 띄운다. 기동이 실패하면서 계산된 값을 알려 준다. 두 값을 같은 비밀 저장소에서
# 함께 받아오지 않는다 — 그러면 대조가 아무것도 확인하지 않는다.
EASYDOC_ENCRYPTION_WRITE_KEY_VERSION=1
EASYDOC_ENCRYPTION_KEY_V1=
EASYDOC_ENCRYPTION_KCV_V1=

# --- LLM provider ---
#
# 기본은 openai. 로컬 Compose 에서 키 없이 변환을 끝내려면 fake 를 쓴다.
# fake 는 Spring 프로필 local 또는 test 에서만 조립된다. compose.yml 의 api·worker 가 local 을 켠다.
# 운영(worker 만)에서 fake 를 넣으면 기동이 실패한다.
# 키가 없는 openai/anthropic 은 앱은 뜨지만, 변환은 ConfigurationException 으로 즉시 영구 실패한다
# (재시도하지 않는다).
EASYDOC_LLM_PROVIDER=openai
EASYDOC_LLM_MODEL=
# Anthropic 전용 사고 깊이: low | medium | high | xhigh | max
EASYDOC_LLM_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 선택한 모델의 현재 공개 단가를 배포 시점에 넣는다. 코드에 가격을 고정하지 않는다.
EASYDOC_LLM_INPUT_USD_PER_MILLION_TOKENS=
EASYDOC_LLM_OUTPUT_USD_PER_MILLION_TOKENS=
