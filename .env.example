# 실제 값은 .env에만 넣고 커밋 금지
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 변환 워커가 쓸 LLM 벤더 (anthropic | openai). 기본값 anthropic은 '벤더 미확정' 상태이며,
# 벤치마크로 확정되면 master-plan 3.1 기록 표와 함께 갱신한다.
# 벤치마크·골든셋 평가는 이 값이 아니라 각자의 --providers·GOLDEN_PROVIDER를 쓴다.
LLM_PROVIDER=anthropic

# 위 벤더의 모델명 덮어쓰기. 비워 두면 provider 구현체의 기본 모델을 쓴다
# (openai=gpt-4.1 — 근거: docs/quality/2026-08-07-model-comparison.md).
# 모델 교체·롤백을 코드 수정 없이 하기 위한 값이며, 다른 벤더에는 적용되지 않는다.
# LLM_MODEL=

# 인프라 (기본값은 docker-compose.yml 기준 — 로컬 개발이면 그대로 두어도 된다)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/easydoc
REDIS_URL=redis://localhost:6379/0

# 브라우저에서 API를 부를 수 있는 오리진 (JSON 배열). 기본값은 개발용 Vite 서버 하나다 —
# 파일럿 배포는 nginx가 프론트·API를 같은 호스트로 서빙해 cross-origin이 아니다.
CORS_ORIGINS=["http://localhost:5173"]

# 인증 토큰 서명 키 — 생성: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# 문서 본문 암호화 키 — 생성:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
