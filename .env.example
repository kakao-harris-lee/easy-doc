# 실제 값은 .env에만 넣고 커밋 금지
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Kotlin LLM provider 구성. 기본은 master-plan의 현재 운영값인 openai / gpt-4.1이다.
EASYDOC_LLM_PROVIDER=openai
EASYDOC_LLM_MODEL=gpt-4.1
# Anthropic 전용 사고 깊이: low | medium | high | xhigh | max
EASYDOC_LLM_EFFORT=
# 선택한 모델의 현재 공개 단가를 배포 시점에 넣는다. 코드에 가격을 고정하지 않는다.
EASYDOC_LLM_INPUT_USD_PER_MILLION_TOKENS=
EASYDOC_LLM_OUTPUT_USD_PER_MILLION_TOKENS=

# 인프라 (기본값은 docker-compose.yml 기준 — 로컬 개발이면 그대로 두어도 된다)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/easydoc
REDIS_URL=redis://localhost:6379/0

# 브라우저에서 API를 부를 수 있는 오리진 (JSON 배열). 기본값은 개발용 Vite 서버 하나다 —
# 파일럿 배포는 nginx가 프론트·API를 같은 호스트로 서빙해 cross-origin이 아니다.
CORS_ORIGINS=["http://localhost:5173"]

# 인증 토큰 서명 키 — 생성: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# 문서 본문 암호화 키 — 생성:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Kotlin 런타임(backend-kotlin) 저장 암호화 ─────────────────────────────────
#
# 위 FERNET_KEY 와 **다른 축이다.** Python 은 Fernet, Kotlin 은 표준 AEAD(AES-256-GCM)이고
# 2026-08-12 재개발 전환으로 둘 사이의 암호문 호환 요구가 사라졌다(master-plan 6.2).
#
# 키 생성:
#   openssl rand -base64 32
#
# 검사값(KCV)은 **비밀이 아니다** — 키가 맞는지 배포 파이프라인이 대조하는 지문이고,
# 값을 모르면 KCV 없이 한 번 띄워라. 기동이 실패하면서 계산된 값을 알려 준다.
# 두 값을 같은 비밀 저장소에서 함께 받아 오지 않는다 — 그러면 대조가 아무것도 확인하지 않는다.
EASYDOC_ENCRYPTION_WRITE_KEY_VERSION=1
EASYDOC_ENCRYPTION_KEY_V1=
EASYDOC_ENCRYPTION_KCV_V1=
