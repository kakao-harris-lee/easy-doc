# 프론트 정적 서빙 이미지. 빌드(node)와 서빙(nginx)을 나눠, 최종 이미지에는
# 소스와 node_modules가 남지 않는다.
# 빌드 컨텍스트는 리포 루트다(백엔드와 .dockerignore를 공유한다).

# vite 8·rolldown이 요구하는 하한이 node ^20.19다 — 20 태그의 현재 릴리스가 이를 만족한다.
FROM node:20-alpine AS build

WORKDIR /build

# 의존성 레이어를 먼저 굳힌다. 소스만 바뀐 빌드는 이 층을 캐시에서 재사용한다.
# npm ci: package-lock.json과 어긋나면 락을 갱신하는 대신 빌드를 실패시킨다
# (이미지가 조용히 다른 버전을 담지 않게).
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# 같은 호스트의 nginx가 /api를 api 컨테이너로 넘긴다. 절대 주소를 굽지 않아야
# 브라우저가 동일 출처로만 말하고, 배포처마다 이미지를 다시 만들 필요도 없다.
ENV VITE_API_BASE_URL=/api
RUN npm run build

FROM nginx:alpine

# 기본 서버 정의를 우리 것으로 대체한다(nginx.conf가 conf.d/*.conf를 include한다).
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
